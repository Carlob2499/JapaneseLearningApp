    "framing": [
      {
        "text": "You step up to the register with your basket. The clerk looks up.",
        "phraseId": "phrase:m2:irasshaimase",
        "modelWritten": true
      },
      {
        "beatId": "beat:decode-warm",
        "text": "The clerk holds up your bento, gesturing toward the microwave, and asks something. What do they mean?",
        "phraseId": "phrase:m2:atatamemasu-ka",
        "modelWritten": true
      },
      {
        "beatId": "beat:name-bag",
        "text": "The clerk nods toward a stack of plastic bags by the register. This time you have to come up with the word yourself — which one is it?",
        "phraseId": "phrase:m2:reji-bukuro",
        "modelWritten": true
      },
      {
        "beatId": "beat:say-it",
        "text": "There's one more thing you want. No pointing, no menu — you just say it, and type it out for the clerk.",
        "modelWritten": true
      },
      {
        "beatId": "beat:decode-total",
        "text": "The register beeps and the clerk rattles off your total — read the word on the screen before the moment passes.",
        "phraseId": "phrase:m2:kaikei-ichiman",
        "modelWritten": true
      },
      {
        "beatId": "beat:closing-line",
        "text": "Change counted, bag in hand, you turn for the door. What does a good clerk call after you as you leave?",
        "phraseId": "phrase:m2:mata-okoshi-kudasaimase",
        "modelWritten": true
      },
      {
        "text": "The automatic door slides open, and the clerk's thanks follow you out into the street.",
        "phraseId": "phrase:m2:arigatou-gozaimashita",
        "modelWritten": true
      }
    ]
  },
